#!/usr/bin/env bash
#ddev-generated
# Composer: vendor/ exists and matches composer.lock.
# --dry-run compares lock file and installed packages without network access.

source "$PROJECT_STATUS_DIR/lib/i18n.sh"

[[ -f "$COMPOSER_DIR/composer.json" ]] || { t composer.no_json "$COMPOSER_DIR"; exit 3; }

if [[ ! -d "$COMPOSER_DIR/vendor" ]]; then
  t composer.no_vendor
  echo "next: $COMPOSER_HINT"
  exit 2
fi

output=$(composer install --dry-run --no-interaction --working-dir="$COMPOSER_DIR" 2>&1)

if grep -q "Nothing to install, update or remove" <<< "$output"; then
  t composer.ok
  exit 0
fi

# composer.json requires a package that composer.lock does not contain: "composer install" cannot fix that,
# 15-composer-lock reports the outdated composer.lock
if grep -q "is not present in the lock file" <<< "$output"; then
  t composer.not_comparable
  exit 3
fi

t composer.outdated
echo "next: $COMPOSER_HINT"
exit 1
